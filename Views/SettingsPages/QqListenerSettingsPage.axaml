<ci:SettingsPageBase x:Class="QQListener.Views.SettingsPages.QqListenerSettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="600">

    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro" Spacing="4">

            <!-- Page Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ci:FluentIcon FontSize="48"
                    Glyph="&#xE02B;"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="24" FontWeight="SemiBold">QQListener</TextBlock>
                    <TextBlock FontSize="13"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        监听 QQ 通知并转发为 ClassIsland 提醒
                    </TextBlock>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{Binding PluginInfo.HeaderLine}" />
                </StackPanel>
            </StackPanel>

            <!-- 快捷操作 -->
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,12,0,0">
                快捷操作
            </TextBlock>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,4">
                <Button Click="OnPollNowClick" IsEnabled="{Binding CanPoll}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ci:FluentIcon Glyph="&#xE72C;" />
                        <TextBlock Text="手动扫一次" />
                    </StackPanel>
                </Button>
                <Button Click="OnResetClick" IsEnabled="{Binding ProviderAvailable}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ci:FluentIcon Glyph="&#xE71D;" />
                        <TextBlock Text="重置去重" />
                    </StackPanel>
                </Button>
                <Button Click="OnReplayLatestClick" IsEnabled="{Binding CanReplay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ci:FluentIcon Glyph="&#xE0A5;" />
                        <TextBlock Text="重示最后一条" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 基础设置 -->
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,12,0,0">
                基础设置
            </TextBlock>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE72A;}"
                                       Header="启用监听"
                                       Description="开启或关闭 QQ 通知监听功能">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsEnabled, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE16C;}"
                                       Header="仅处理 QQ 通知"
                                       Description="只监听来自 QQ 应用的通知，忽略其他应用">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.QqOnly, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE77B;}"
                                       Header="@ 我时作为重要消息"
                                       Description="当 QQ 通知包含「有人@我」时，作为重要消息提醒">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.SomeoneAtMe, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE717;}"
                                       Header="启用呼叫关键词"
                                       Description="检测消息中的呼叫关键词，触发特殊的长时间置顶提醒">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.CallingEnabled, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE70F;}"
                                       Header="呼叫关键词"
                                       Description="当消息包含此关键词时，将触发呼叫提醒">
                <controls:SettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.CallingKeyword, Mode=TwoWay}"
                             Width="180"
                             HorizontalAlignment="Right" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <!-- 时间与显示设置 -->
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,20,0,0">
                时间与显示
            </TextBlock>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE916;}"
                                       Header="扫描间隔（秒）"
                                       Description="轮询 Windows 通知中心的间隔时间，范围 0.1~5 秒">
                <controls:SettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.ScanIntervalSeconds, Mode=TwoWay}"
                             Width="100"
                             HorizontalAlignment="Right" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE4D6;}"
                                       Header="去重冷却（秒）"
                                       Description="相同内容的通知在冷却时间内不会重复提醒，范围 1~3600 秒">
                <controls:SettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.CooldownSeconds, Mode=TwoWay}"
                             Width="100"
                             HorizontalAlignment="Right" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE917;}"
                                       Header="普通消息显示时长（秒）"
                                       Description="普通 QQ 消息的提醒显示时长，范围 1~3600 秒">
                <controls:SettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.NormalDurationSeconds, Mode=TwoWay}"
                             Width="100"
                             HorizontalAlignment="Right" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE735;}"
                                       Header="重要消息显示时长（秒）"
                                       Description="重要 QQ 消息的提醒显示时长，范围 1~3600 秒">
                <controls:SettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.ImportantDurationSeconds, Mode=TwoWay}"
                             Width="100"
                             HorizontalAlignment="Right" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE02A;}"
                                       Header="呼叫消息显示时长（秒）"
                                       Description="呼叫类消息的提醒显示时长，范围 1~86400 秒">
                <controls:SettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.CallingDurationSeconds, Mode=TwoWay}"
                             Width="100"
                             HorizontalAlignment="Right" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE840;}"
                                       Header="普通消息置顶"
                                       Description="普通消息提醒是否显示在最前方">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.NormalTopmost, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE840;}"
                                       Header="重要消息置顶"
                                       Description="重要消息提醒是否显示在最前方">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ImportantTopmost, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE840;}"
                                       Header="呼叫消息置顶"
                                       Description="呼叫消息提醒是否显示在最前方">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.CallingTopmost, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE9F5;}"
                                       Header="滚动速度"
                                       Description="消息文本滚动速度，0 表示不滚动，范围 0~4">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Slider Value="{Binding Settings.RollingSpeed, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="4"
                                TickFrequency="0.1"
                                Width="160"
                                VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Settings.RollingSpeed, StringFormat={}{0:F2}}"
                                   Width="40"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <!-- 过滤规则 -->
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,20,0,0">
                过滤规则
            </TextBlock>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE8F2;}"
                                       Header="允许的来源（每行一个）"
                                       Description="仅处理这些来源；留空允许全部。来源精确匹配并忽略大小写">
                <controls:SettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.AllowedSourcesText, Mode=TwoWay}"
                             AcceptsReturn="True"
                             MinHeight="100"
                             TextWrapping="Wrap"
                             HorizontalAlignment="Stretch" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE916;}"
                                       Header="允许时间段"
                                       Description="只在指定时间段内提醒">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.RuleTimeWindowEnabled, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE823;}"
                                       Header="允许时间范围"
                                       Description="开始和结束均使用 HH:mm 格式；跨午夜时间段会自动识别">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{Binding Settings.RuleTimeWindowStartText, Mode=TwoWay}"
                                 Width="80"
                                 Watermark="开始" />
                        <TextBlock Text="至" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Settings.RuleTimeWindowEndText, Mode=TwoWay}"
                                 Width="80"
                                 Watermark="结束" />
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE92F;}"
                                       Header="重要人物（每行一个）"
                                       Description="来自这些人物的消息将被标记为重要消息">
                <controls:SettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.ImportantPersonsText, Mode=TwoWay}"
                             AcceptsReturn="True"
                             MinHeight="100"
                             TextWrapping="Wrap"
                             HorizontalAlignment="Stretch" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE6B1;}"
                                       Header="重要关键词（每行一个）"
                                       Description="包含这些关键词的消息将被标记为重要消息">
                <controls:SettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.ImportantKeywordsText, Mode=TwoWay}"
                             AcceptsReturn="True"
                             MinHeight="100"
                             TextWrapping="Wrap"
                             HorizontalAlignment="Stretch" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE71D;}"
                                       Header="黑名单（每行一个）"
                                       Description="包含这些关键词的消息将被忽略">
                <controls:SettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.BlacklistText, Mode=TwoWay}"
                             AcceptsReturn="True"
                             MinHeight="100"
                             TextWrapping="Wrap"
                             HorizontalAlignment="Stretch" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,20,0,0">
                规则测试与预设
            </TextBlock>

            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4">
                预设将替换人物/关键词/呼叫规则，不改来源和时间段。
            </TextBlock>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                <Button Click="OnApplyHomeworkPresetClick" Content="作业提醒预设" />
                <Button Click="OnApplyTeacherCallingPresetClick" Content="老师呼叫预设" />
                <Button Click="OnApplyExamNoticePresetClick" Content="考试通知预设" />
            </StackPanel>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE8F2;}"
                                       Header="测试规则"
                                       Description="输入模拟 Toast 文本；来源留空时使用 qq.toast，时间留空时使用当前本地时间。">
                <controls:SettingsExpander.Footer>
                    <StackPanel Spacing="8">
                        <TextBox Text="{Binding PreviewToastText, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 MinHeight="80"
                                 TextWrapping="Wrap"
                                 Watermark="模拟 Toast 多行文本" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding PreviewSourceText, Mode=TwoWay}"
                                     Width="160"
                                     Watermark="来源 ID" />
                            <TextBox Text="{Binding PreviewTimeText, Mode=TwoWay}"
                                     Width="80"
                                     Watermark="HH:mm" />
                            <Button Click="OnPreviewRulesClick" Content="测试规则" />
                        </StackPanel>
                        <TextBlock Text="{Binding PreviewResultText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <!-- 诊断状态 -->
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,20,0,0">
                诊断状态
            </TextBlock>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE895;}"
                                       Header="运行环境"
                                       Description="{Binding Diagnostics.RuntimeSummary}"
                                       IsExpanded="False">
                <controls:SettingsExpander.Items>
                    <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource Glyph=&#xE8B7;}"
                                                   Content="插件目录">
                        <controls:SettingsExpanderItem.Footer>
                            <SelectableTextBlock Text="{Binding Diagnostics.PluginFolderPath}"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                 MaxWidth="380"
                                                 TextWrapping="Wrap" />
                        </controls:SettingsExpanderItem.Footer>
                    </controls:SettingsExpanderItem>

                    <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource Glyph=&#xE8A5;}"
                                                   Content="当前 DLL">
                        <controls:SettingsExpanderItem.Footer>
                            <SelectableTextBlock Text="{Binding Diagnostics.AssemblyPath}"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                 MaxWidth="380"
                                                 TextWrapping="Wrap" />
                        </controls:SettingsExpanderItem.Footer>
                    </controls:SettingsExpanderItem>

                    <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource Glyph=&#xE713;}"
                                                   Content="配置文件">
                        <controls:SettingsExpanderItem.Footer>
                            <SelectableTextBlock Text="{Binding Diagnostics.SettingsPath}"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                 MaxWidth="380"
                                                 TextWrapping="Wrap" />
                        </controls:SettingsExpanderItem.Footer>
                    </controls:SettingsExpanderItem>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE9D9;}"
                                       Header="监听状态"
                                       Description="{Binding Diagnostics.ListenerState}" />

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE8D7;}"
                                       Header="通知权限"
                                       Description="{Binding Diagnostics.PermissionStatus}" />

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE823;}"
                                       Header="最近读取"
                                       Description="{Binding Diagnostics.LastReadSummary}" />

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE8EF;}"
                                       Header="AppInfo 状态"
                                       Description="{Binding Diagnostics.AppIdentityStatus}" />

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE71C;}"
                                       Header="QQOnly 筛选"
                                       Description="{Binding Diagnostics.LastCandidateSummary}" />

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE930;}"
                                       Header="最近接收"
                                       Description="{Binding Diagnostics.LastAcceptedSummary}" />

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE711;}"
                                       Header="最近忽略"
                                       Description="{Binding Diagnostics.LastIgnoredReason}" />

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE7BA;}"
                                       Header="格式诊断"
                                       Description="{Binding Diagnostics.LastFormatSummary}" />

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xEB90;}"
                                       Header="最近错误"
                                       Description="{Binding Diagnostics.LastErrorSummary}" />

            <!-- 关于 -->
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,20,0,0">
                关于
            </TextBlock>

            <Border CornerRadius="4"
                    ClipToBounds="True"
                    Margin="0,4,0,4">
                <controls:SettingsExpanderItem>
                    <Grid Margin="12" ColumnDefinitions="Auto,*,Auto">
                        <ci:FluentIcon Glyph="&#xE02B;"
                                       Grid.Column="0"
                                       FontSize="48"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock>
                                <Run Text="QQListener  " FontSize="20" FontWeight="SemiBold" />
                                <Run Text="{Binding PluginInfo.VersionDisplay, Mode=OneWay}"
                                     FontSize="14"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding PluginInfo.CopyrightLine}" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding PluginInfo.LicenseLine}" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding PluginInfo.SdkLine}" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding PluginInfo.OriginalAuthor}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Top">
                            <Button Padding="8,5"
                                    BorderBrush="Transparent"
                                    Background="Transparent"
                                    ToolTip.Tip="GitHub 仓库"
                                    Command="{x:Static ci:UriNavigationCommands.UriNavigationCommand}"
                                    CommandParameter="{Binding PluginInfo.Url}">
                                <ci:FluentIcon Glyph="&#xE71B;" FontSize="18" />
                            </Button>
                            <Button Padding="8,5"
                                    BorderBrush="Transparent"
                                    Background="Transparent"
                                    ToolTip.Tip="常见问题 Q&amp;A"
                                    Command="{x:Static ci:UriNavigationCommands.UriNavigationCommand}"
                                    CommandParameter="{Binding PluginInfo.QaUrl}">
                                <ci:FluentIcon Glyph="&#xE897;" FontSize="18" />
                            </Button>
                            <Button Padding="8,5"
                                    BorderBrush="Transparent"
                                    Background="Transparent"
                                    ToolTip.Tip="报告问题"
                                    Command="{x:Static ci:UriNavigationCommands.UriNavigationCommand}"
                                    CommandParameter="{Binding PluginInfo.IssuesUrl}">
                                <ci:FluentIcon Glyph="&#xEA39;" FontSize="18" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </controls:SettingsExpanderItem>
            </Border>

        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
