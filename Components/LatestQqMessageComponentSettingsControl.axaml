<ci:ComponentBase x:Class="QQListener.Components.LatestQqMessageComponentSettingsControl"
                  x:TypeArguments="settings:LatestQqMessageComponentSettings"
                  xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                  xmlns:local="clr-namespace:QQListener.Components"
                  xmlns:settings="clr-namespace:QQListener.Models.ComponentSettings">
    <ScrollViewer>
        <StackPanel DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:LatestQqMessageComponentSettingsControl}}"
                    Classes="component-settings-container animated-intro"
                    Spacing="4">
            <controls:SettingsExpander Header="无消息占位"
                                       Description="没有收到 QQ 消息时是否显示占位文本"
                                       IconSource="{ci:FluentIconSource &#xE7BA;}">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ShowPlaceholder, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="占位文本"
                                       Description="没有收到 QQ 消息时显示的文本"
                                       IconSource="{ci:FluentIconSource &#xF171;}">
                <controls:SettingsExpander.Footer>
                    <TextBox MinWidth="180"
                             Text="{Binding Settings.PlaceholderText, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="发送人"
                                       Description="是否在组件中显示消息发送人"
                                       IconSource="{ci:FluentIconSource &#xE77B;}">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ShowSender, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="状态标签"
                                       Description="是否显示重要/呼叫状态标签"
                                       IconSource="{ci:FluentIconSource &#xE7C1;}">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ShowStatusTag, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</ci:ComponentBase>
