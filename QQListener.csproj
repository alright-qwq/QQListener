<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDynamicLoading>True</EnableDynamicLoading>
        <Version>$(QQListenerVersion)</Version>
        <AssemblyVersion>$(QQListenerVersion)</AssemblyVersion>
        <FileVersion>$(QQListenerVersion)</FileVersion>
        <InformationalVersion>$(QQListenerVersion)</InformationalVersion>
    </PropertyGroup>
    <PropertyGroup>
        <ClassIslandPluginSdkVersion>1.7.106.2-dev-v2</ClassIslandPluginSdkVersion>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="doc\**\*.cs" />
        <Compile Remove="参考\**\*.cs" />
        <Compile Remove="Samples\**\*.cs" />
        <Compile Remove="Tests\**\*.cs" />
        <Compile Remove="Tools\**\*.cs" />
        <AvaloniaResource Remove="doc\**\*" />
        <AvaloniaResource Remove="参考\**\*" />
        <AvaloniaResource Remove="Samples\**\*" />
        <AvaloniaResource Remove="Tests\**\*" />
        <AvaloniaResource Remove="Tools\**\*" />
        <AvaloniaXaml Remove="doc\**\*" />
        <AvaloniaXaml Remove="参考\**\*" />
        <AvaloniaXaml Remove="Samples\**\*" />
        <AvaloniaXaml Remove="Tests\**\*" />
        <AvaloniaXaml Remove="Tools\**\*" />
        <Content Remove="doc\**\*" />
        <Content Remove="参考\**\*" />
        <Content Remove="Samples\**\*" />
        <Content Remove="Tests\**\*" />
        <Content Remove="Tools\**\*" />
        <EmbeddedResource Remove="doc\**\*" />
        <EmbeddedResource Remove="参考\**\*" />
        <EmbeddedResource Remove="Samples\**\*" />
        <EmbeddedResource Remove="Tests\**\*" />
        <EmbeddedResource Remove="Tools\**\*" />
        <None Remove="doc\**\*" />
        <None Remove="参考\**\*" />
        <None Remove="Samples\**\*" />
        <None Remove="Tests\**\*" />
        <None Remove="Tools\**\*" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ClassIsland.PluginSdk" Version="$(ClassIslandPluginSdkVersion)">
            <ExcludeAssets>runtime; native</ExcludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Update="manifest.yml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="README.md">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="icon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <Target Name="SyncLocalClassIslandDebugPlugin" AfterTargets="Build"
            Condition="'$(Configuration)' == 'Debug' and Exists('..\ClassIsland\ClassIsland.Desktop\bin\Debug\net8.0-windows10.0.19041.0')">
        <PropertyGroup>
            <LocalClassIslandPluginDir>..\ClassIsland\ClassIsland.Desktop\bin\Debug\net8.0-windows10.0.19041.0\Plugins\QQListener\</LocalClassIslandPluginDir>
        </PropertyGroup>
        <ItemGroup>
            <LocalPluginFiles Include="$(TargetDir)*.*" />
        </ItemGroup>
        <MakeDir Directories="$(LocalClassIslandPluginDir)" />
        <Copy SourceFiles="@(LocalPluginFiles)"
              DestinationFolder="$(LocalClassIslandPluginDir)"
              SkipUnchangedFiles="true"
              Retries="0"
              ContinueOnError="WarnAndContinue" />
        <Message Importance="high"
                 Text="Synced QQListener debug build to $(LocalClassIslandPluginDir)" />
    </Target>

</Project>
